{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CopyBenchmarkResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "slides",
    "caption"
  ],
  "properties": {
    "format": {
      "type": "string",
      "enum": [
        "GM-SINGLE-01",
        "GM-COMPARE-01",
        "GM-CAROUSEL-01"
      ]
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slide_index",
          "role",
          "headline",
          "body_blocks",
          "commentary",
          "mascot_direction"
        ],
        "properties": {
          "slide_index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "role": {
            "type": "string",
            "enum": [
              "HOOK",
              "EVIDENCE",
              "CONTEXT",
              "MEANING",
              "VERDICT",
              "SOURCES"
            ]
          },
          "headline": {
            "type": "string",
            "maxLength": 140
          },
          "body_blocks": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "text",
                "claim_ids"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "FACT",
                    "ANALYSIS"
                  ]
                },
                "text": {
                  "type": "string",
                  "maxLength": 600
                },
                "claim_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "commentary": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 240
          },
          "mascot_direction": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          }
        }
      }
    },
    "caption": {
      "type": "string",
      "maxLength": 1500
    }
  }
}