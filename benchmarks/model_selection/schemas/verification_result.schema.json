{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerificationBenchmarkResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "confidence",
    "evidence_assessment",
    "material_caveats",
    "missing_evidence",
    "requires_human_review",
    "rationale_summary"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "SUPPORTED",
        "MOSTLY_SUPPORTED",
        "PARTLY_SUPPORTED",
        "MIXED",
        "MISLEADING_WITHOUT_CONTEXT",
        "CONTRADICTED",
        "NOT_ESTABLISHED"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_assessment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "assessment"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "assessment": {
            "type": "string",
            "enum": [
              "SUPPORTS",
              "CONTRADICTS",
              "QUALIFIES",
              "CONTEXT",
              "INSUFFICIENT"
            ]
          }
        }
      }
    },
    "material_caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires_human_review": {
      "type": "boolean"
    },
    "rationale_summary": {
      "type": "string",
      "maxLength": 1200
    }
  }
}